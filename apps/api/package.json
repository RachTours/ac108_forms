{
  "name": "@reviewroom/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:assignment-preflight": "tsx src/scripts/check-assignment-integrity.ts",
    "db:migrate:dev": "prisma migrate dev --name init",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap-owner": "tsx src/scripts/bootstrap-owner.ts",
    "db:bootstrap-owner:prod": "node dist/scripts/bootstrap-owner.js",
    "test": "npm run build --workspace @reviewroom/contracts && npm run build --workspace @reviewroom/domain && npm run build && node --test"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@reviewroom/contracts": "1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.0.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "prisma": "^7.0.0",
    "zod": "^4.1.12",
    "@reviewroom/domain": "1.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
