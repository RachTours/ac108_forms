HOST=0.0.0.0
NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-bytes
API_PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reviewroom
DB_USER=reviewroom_app
DB_PASSWORD=replace-with-a-local-mysql-password
DATABASE_CONNECTION_LIMIT=10
# Required in production: 32 random bytes encoded as base64url. Generate a unique value and keep it out of source control.
TOKEN_ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000

# Hostinger build setting only; set in both Hostinger Node.js app environments when production installs omit dev dependencies.
NPM_CONFIG_INCLUDE=dev

# Used only for the one-time owner bootstrap command. Remove from the process environment after setup.
BOOTSTRAP_EMAIL=admin@rr.local
BOOTSTRAP_NAME=Workspace Owner
BOOTSTRAP_PASSWORD=replace-with-a-random-password-at-least-14-chars
BOOTSTRAP_ORGANIZATION=Review Workspace
BOOTSTRAP_SLUG=review-workspace

# Optional reverse-proxy IPs (comma-separated CIDRs or addresses). Keep empty for local development.
TRUSTED_PROXIES=

# Optional compatibility for existing environments. When present, DB_* values take precedence.
# DATABASE_URL=mysql://reviewroom_app:replace-with-a-password@127.0.0.1:3306/reviewroom
